
@{
    ViewData["Title"] = "Preventiva";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container-fluid p-0">

    <div class="row">
        <div class="col-12 col-xl-6">
            <div class="card">
                <div class="card-header">
                    <h2 class="card-title">Preventiva</h2>
                    <h6 class="card-subtitle text-muted">Configuración para las notificaciones de la opción de preventiva a los clientes</h6>
                </div>
                <div class="card-body">
                    <form>
                        <div class="mb-3">
                            <label class="form-check">
                                <input class="form-check-input" type="checkbox" id="notyf-ripple" >
                                <span class="form-check-label">
                                    Notificación Preventiva Global Activada
                                </span>
                            </label>
                        </div>
                        <div class="mb-3">
                            <label class="form-label">Dias Previos al Vencimiento</label>
                            <input type="email" class="form-control" placeholder="##">
                        </div>
                        <div class="mb-3">
                            <label class="form-label">Dias de Repetición</label>
                            <input type="password" class="form-control" placeholder="##">
                        </div>
                        <div class="mb-3">
                            <label class="form-check">
                                <input class="form-check-input" type="checkbox" id="notyf-ripple" >
                                <span class="form-check-label">Correo Electronico</span>
                            </label>
                        </div>
                        <div class="mb-3">
                            <label class="form-check">
                                <input class="form-check-input" type="checkbox" id="notyf-ripple"  >
                                <span class="form-check-label">Whatsapp</span>
                            </label>
                        </div>
                        <div class="mb-3">
                            <label class="form-check">
                                <input class="form-check-input" type="checkbox" id="notyf-ripple"  >
                                <span class="form-check-label">Mensaje Texto</span>
                            </label>
                        </div>
                        <button type="submit" class="btn btn-primary">Guardar</button>
                    </form>
                </div>
            </div>
        </div>
    </div>

</div>

