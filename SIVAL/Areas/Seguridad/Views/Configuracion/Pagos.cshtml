
@{
    ViewData["Title"] = "Pagos";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container-fluid p-0">

    <div class="row">
        <div class="col-12 col-xl-6">
            <div class="card">
                <div class="card-header">
                    <h2 class="card-title">Pagos Realizados</h2>
                    <h6 class="card-subtitle text-muted">Configuración para las notificaciones para los clientes que realizaron sus pagos</h6>
                </div>
                <div class="card-body">
                    <form>
                        <div class="mb-3">
                            <label class="form-check">
                                <input class="form-check-input" type="checkbox" id="notyf-ripple">
                                <span class="form-check-label">
                                    Notificación Cobranza Global de Pagos Realizados
                                </span>
                            </label>
                        </div>
                        <div class="mb-3">
                            <label class="form-label">Dias Posterior al pago de la cuota realizada</label>
                            <input type="email" class="form-control" placeholder="1 por defecto">
                        </div>                        
                        <div class="mb-3">
                            <label class="form-check">
                                <input class="form-check-input" type="checkbox" id="notyf-ripple">
                                <span class="form-check-label">Correo Electronico</span>
                            </label>
                        </div>
                        <div class="mb-3">
                            <label class="form-check">
                                <input class="form-check-input" type="checkbox" id="notyf-ripple">
                                <span class="form-check-label">Whatsapp</span>
                            </label>
                        </div>
                        <div class="mb-3">
                            <label class="form-check">
                                <input class="form-check-input" type="checkbox" id="notyf-ripple">
                                <span class="form-check-label">Mensaje Texto</span>
                            </label>
                        </div>
                        <button type="submit" class="btn btn-primary">Guardar</button>
                    </form>
                </div>
            </div>
        </div>
    </div>

</div>
