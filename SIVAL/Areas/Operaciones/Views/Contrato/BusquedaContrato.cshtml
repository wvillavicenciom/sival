
@{
    ViewData["Title"] = "Busqueda";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@section Scripts {
    <script src="~/js/ClienteApp/Operaciones/Contrato/Busquedacontrato.js"></script>
}

<div class="container-fluid p-0" ng-controller="BusquedaContratos">


    <div class="card">
        <div class="card-header">
            <h5 class="card-title">Búsqueda de Contratos</h5>
            <h6 class="card-subtitle text-muted">Ingrese alguno de los datos para filtrar el resultado de la búsqueda o haga clic en el botón buscar directamente para mostrar todos los registros</h6>
        </div>
        <div class="card-body">
            <form class="row row-cols-md-auto align-items-center">
                <div class="col-8">
                    <label class="sr-only" for="inlineFormInputName2">Contrato</label>
                    <input type="text" class="form-control mb-2 mr-sm-2" id="inlineFormInputName2" placeholder="Documento" ng-model="txtDocumento">
                </div>

                <div class="col-8">
                    <label class="sr-only" for="inlineFormInputName2">Documento</label>
                    <input type="text" class="form-control mb-2 mr-sm-2" id="inlineFormInputName2" placeholder="Código" ng-model="txtDocumento">
                </div>

                <div class="col-8">
                    <label class="sr-only" for="inlineFormInputName2">Apellido Paterno</label>
                    <input type="text" class="form-control mb-2 mr-sm-2" id="inlineFormInputName2" placeholder="Apellidos o Nombres">
                </div>

                <div class="col-8">
                    <label class="sr-only" for="inlineFormInputName2">Fecha Inic</label>
                    <input type="text" class="form-control mb-2 mr-sm-2" id="inlineFormInputName2" placeholder="Fecha Inicial">
                </div>

                <div class="col-8">
                    <label class="sr-only" for="inlineFormInputName2">Fecha Fin</label>
                    <input type="text" class="form-control mb-2 mr-sm-2" id="inlineFormInputName2" placeholder="Fecha Final">
                </div>

                @*<div class="col-12">
                        <label class="sr-only" for="inlineFormInputGroupUsername2">Username</label>
                        <div class="input-group mb-2 mr-sm-2">
                            <div class="input-group-text"></div>
                            <input type="text" class="form-control" id="inlineFormInputGroupUsername2" placeholder="Código">
                        </div>
                    </div>

                    <div class="col-12">
                        <label class="sr-only" for="inlineFormInputGroupUsername2">Apellidos o Nombres</label>
                        <div class="input-group mb-2 mr-sm-2">
                            <div class="input-group-text"></div>
                            <input type="text" class="form-control" id="inlineFormInputGroupUsername2" placeholder="Apellidos o Nombres">
                        </div>
                    </div>*@

                <div class="col-12">
                    <button type="submit" class="btn btn-primary mb-2" ng-click="btnBuscar()">Buscar</button>
                </div>
            </form>
        </div>
    </div>


    <div class="card">
        <div class="card-header">
            <h5 class="card-title">Resultados</h5>
        </div>
        <div class="card-body">
            <table id="taContratos" class="table table-responsive table-sm table-hover" style="width:100%">
                <thead>
                    <tr>
                        <th>#</th>
                        <th>Contrato</th>
                        <th>Precio</th>
                        <th>Inicial</th>
                        <th>Financiado</th>
                        <th>Plazo</th>
                        <th>TEA</th>
                        <th>Saldo</th>
                        <th>-</th>
                    </tr>
                </thead>
                <tfoot>
                    <tr>
                        <th>#</th>
                        <th>Contrato</th>
                        <th>Precio</th>
                        <th>Inicial</th>
                        <th>Financiado</th>
                        <th>Plazo</th>
                        <th>TEA</th>
                        <th>Saldo</th>
                        <th>-</th>
                    </tr>
                </tfoot>
            </table>
        </div>
    </div>



    <!-- Modal Contratos-->
