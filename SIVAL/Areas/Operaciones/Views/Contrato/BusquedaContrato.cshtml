                                                    </div>
                                                    <div class="mb-3 col-md-6">
                                                        <label for="inputLastName" class="form-label">Fecha Activacion</label>
                                                        <input type="date" class="form-control" id="inputLastName" ng-model="txtFechaActivacion" placeholder="Ingrese fecha">
                                                    </div>
                                                </div>
                                                <div class="row">
                                                    <div class="mb-3 col-md-6">
                                                        <label for="inputFirstName" class="form-label">Moneda</label>
                                                        <select class="form-control " ng-model="ddlMoneda" ng-options="item as item.nombre for item in oListaMoneda"></select>
                                                    </div>
                                                    <div class="mb-3 col-md-6">
                                                        <label for="inputLastName" class="form-label">Estado</label>
                                                        <select class="form-control" ng-model="ddlEstadoContrato" ng-options="item as item.nombre for item in oListaEstadoContrato"></select>
                                                    </div>
                                                </div>
                                                <div class="row">
                                                    <div class="mb-3 col-md-6">
                                                        <label for="inputFirstName" class="form-label">Plazo</label>
                                                        <input type="number" class="form-control" id="inputFirstName" ng-model="txtPlazo" placeholder="ingrese telefono principal">
                                                    </div>
                                                    <div class="mb-3 col-md-6">
                                                        <label for="inputLastName" class="form-label">TEA</label>
                                                        <input type="text" class="form-control" id="inputLastName" ng-model="txtTEA" placeholder="Ingrese correo principal">
                                                    </div>
                                                </div>
