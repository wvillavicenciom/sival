                                                <button type="submit" class="btn btn-primary">Guardar</button>
                                            </form>

                                        </div>
                                    </div>
                                </div>
                                <div class="tab-pane fade active" id="cronograma" role="tabpanel">
                                    <div class="card">
                                        <div class="card-header">
                                            <h5 class="card-title mb-0">Listado de Cuotas</h5>
                                        </div>
                                        <div class="card-body">
                                            @*<div class="row col-lg-12">*@
                                                <table id="taCronograma" class="table table-responsive table-sm table-hover" >
                                                    <thead>
                                                        <tr>
                                                            <th>#</th>
                                                            <th>Vencimiento</th>
                                                            <th>Capital</th>
                                                            <th>Interés</th>
                                                            <th>Desgr.</th>
