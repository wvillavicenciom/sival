                                                    <tr>
                                                        <th>Fecha Activado</th>
                                                        <td>{{laFechaActivacion}}</td>
                                                    </tr>
                                                    <tr>
                                                        <th>Precio</th>
                                                        <td>{{laPrecio}}</td>
                                                    </tr>
                                                    <tr>
                                                        <th>Inicial</th>
                                                        <td>{{laPorcInicial}}%- {{laInicial}}</td>
                                                    </tr>
                                                    <tr>
                                                        <th>Financiamiento</th>
                                                        <td>{{laFinanciamiento}}</td>
                                                    </tr>
                                                    <tr>
                                                        <th>Plazo</th>
                                                        <td>{{laPlazo}}</td>
                                                    </tr>
                                                    <tr>
                                                        <th>TEA</th>
                                                        <td>{{laTEA}}</td>
                                                    </tr>
                                                    <tr>
                                                        <th>Saldo</th>
                                                        <td>S/. {{laSaldo}}</td>
                                                    </tr>
                                                    <tr>
                                                        <th>Cuotas Pagadas</th>
                                                        <td>{{laCuotasPagadas}}</td>
                                                    </tr>
                                                    <tr>
                                                        <th>Status</th>
                                                        <td><span class="badge bg-success">Active</span><span class="badge bg-warning">Moroso</span></td>
                                                    </tr>
                                                    <tr>
                                                        <th>Cuotas Pendientes</th>
                                                        <td>{{laCuotasPendientes}}</td>
                                                    </tr>
                                                    <tr>
                                                        <th>Cuotas Atrasadas</th>
