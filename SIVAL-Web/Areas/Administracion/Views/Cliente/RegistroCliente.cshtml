@{
    ViewData["Title"] = "Registro";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@section Scripts {
    <script src="~/ClienteApp/Administracion/Cliente/RegistroCliente.js"></script>
}

<div class="container-fluid p-0" ng-controller="RegistroCliente">

    <h1 class="h3 mb-3">Registro Cliente</h1>

    <div class="row">
        <div class="col-md-3 col-xl-2">

            <div class="card">
                <div class="card-header">
                    <h5 class="card-title mb-0">Perfil Cliente</h5>
                </div>

                <div class="list-group list-group-flush" role="tablist">
                    <a class="list-group-item list-group-item-action active" data-bs-toggle="list" href="#account" role="tab" aria-selected="true">
                        Datos
                    </a>
                    @*<a class="list-group-item list-group-item-action" data-bs-toggle="list" href="#password" role="tab" aria-selected="false" tabindex="-1">
                    Password
                    </a>*@
                    <a class="list-group-item list-group-item-action" data-bs-toggle="list" href="#Contratos" role="tab" aria-selected="false" tabindex="-1">
                        Contratos
                    </a>
                    <a class="list-group-item list-group-item-action" data-bs-toggle="list" href="#Telefonos" role="tab" aria-selected="false" tabindex="-1">
                        Telefonos
                    </a>
                    <a class="list-group-item list-group-item-action" data-bs-toggle="list" href="#Correos" role="tab" aria-selected="false" tabindex="-1">
                        Correos
                    </a>
                    <a class="list-group-item list-group-item-action" data-bs-toggle="list" href="#Direcciones" role="tab" aria-selected="false" tabindex="-1">
                        Direcciones
                    </a>
                    <a class="list-group-item list-group-item-action" data-bs-toggle="list" href="#Gestiones" role="tab" aria-selected="false" tabindex="-1">
                        Gestiones
                    </a>
                    <a class="list-group-item list-group-item-action" data-bs-toggle="list" href="#NotificacionesAutomaticas" role="tab" aria-selected="false" tabindex="-1">
                        Notificaciones Automáticas
                    </a>
                    <a class="list-group-item list-group-item-action" data-bs-toggle="list" href="#Configuraciones" role="tab" aria-selected="false" tabindex="-1">
                        Configuración
                    </a>
                    @*<a class="list-group-item list-group-item-action" data-bs-toggle="list" href="#" role="tab" aria-selected="false" tabindex="-1">
                    Your data
                    </a>
                    <a class="list-group-item list-group-item-action" data-bs-toggle="list" href="#" role="tab" aria-selected="false" tabindex="-1">
                    Delete account
                    </a>*@
                </div>
            </div>
        </div>

        <div class="col-md-9 col-xl-10">
            <div class="tab-content">
                <!--DATOS-->
                <div class="tab-pane fade active show" id="account" role="tabpanel">

                    <div class="card">
                        <div class="card-header">
                            <h5 class="card-title mb-0">Datos Personales</h5>
                        </div>
                        <div class="card-body">
                                <div class="row">
                                    <div class="mb-3 col-md-6">
                                        <label for="inputFirstName" class="form-label">Tipo Documento</label>
                                        <select class="form-control" ng-model="ddlTipoDocumento" ng-options="item as item.nombre for item in oListaTipoDocumento" ng-disabled="ddlTipoDocumento_Disable"></select>
                                    </div>
                                    <div class="mb-3 col-md-6">
                                        <label for="inputLastName" class="form-label">Documento</label>
                                        <input type="text" class="form-control" id="inputLastName" ng-model="txtDocumento" placeholder="Documento" ng-disabled="txtDocumento_Disable">
                                    </div>
                                </div>
                                <div class="row">
                                    <div class="mb-3 col-md-6">
                                        <label for="inputFirstName" class="form-label">Apellido Paterno</label>
                                        <input type="text" class="form-control" id="inputFirstName" ng-model="txtApellidoPaterno" placeholder="Ingrese apellido paterno">
                                    </div>
                                    <div class="mb-3 col-md-6">
                                        <label for="inputLastName" class="form-label">Apellido Materno</label>
                                        <input type="text" class="form-control" id="inputLastName" ng-model="txtApellidoMaterno" placeholder="Ingrese apellido materno">
                                    </div>
                                </div>
                                <div class="row">
                                    <div class="mb-3 col-md-6">
                                        <label for="inputFirstName" class="form-label">Nombres</label>
                                        <input type="text" class="form-control" id="inputFirstName" ng-model="txtNombres" placeholder="Ingrese nombres">
                                    </div>
                                    <div class="mb-3 col-md-6">
                                        <label for="inputLastName" class="form-label">Fecha Nacimiento</label>
                                        <input type="date" class="form-control" id="inputLastName" ng-model="txtFechaNacimiento" placeholder="Ingrese fecha nacimiento">
                                    </div>
                                </div>
                                <div class="row">
                                    <div class="mb-3 col-md-6">
                                        <label for="inputFirstName" class="form-label">Genero</label>
                                        <select class="form-control mb-1" ng-model="ddlGenero" ng-options="item as item.nombre for item in oListaGenero"></select>
                                    </div>
                                    <div class="mb-3 col-md-6">
                                        <label for="inputLastName" class="form-label">Estado Civil</label>
                                        <select class="form-control mb-1" ng-model="ddlEstadoCivil" ng-options="item as item.nombre for item in oListaEstadoCivil"></select>
                                    </div>
                                </div>
                                <div class="row">
                                    <div class="mb-3 col-md-6">
                                        <label for="inputFirstName" class="form-label">Telefono Principal</label>
                                        <input type="text" class="form-control" id="inputFirstName" ng-model="txtTelefonoPrincipal" placeholder="ingrese telefono principal">
                                    </div>
                                    <div class="mb-3 col-md-6">
                                        <label for="inputLastName" class="form-label">Correo Principal</label>
                                        <input type="text" class="form-control" id="inputLastName" ng-model="txtCorreoPrincipal" placeholder="Ingrese correo principal">
                                    </div>
                                </div>
                                <div class="mb-3">
                                    <label for="inputAddress2" class="form-label">Dirección Principal</label>
                                    <input type="text" class="form-control" id="inputAddress2" ng-model="txtDireccionPrincipal" placeholder="Ingrese su dirección completa">
                                </div>
                                <div class="row">
                                    <div class="mb-3 col-md-4">
                                        <label for="inputCity" class="form-label">Departamento</label>
                                        <select class="form-control mb-3" ng-model="ddlDepartamento" ng-options="item as item.nombre for item in oListaDepartamento" ng-change="btnCargarProvincia()"></select>
                                    </div>
                                    <div class="mb-3 col-md-4">
                                        <label for="inputState" class="form-label">Provincia</label>
                                        <select class="form-control mb-3" ng-model="ddlProvincia" ng-options="item as item.nombre for item in oListaProvincia" ng-change="btnCargarDistrito()"></select>
                                    </div>
                                    <div class="mb-3 col-md-4">
                                        <label for="inputZip" class="form-label">Distrito</label>
                                        <select class="form-control mb-3" ng-model="ddlDistrito" ng-options="item as item.nombre for item in oListaDistrito"></select>
                                    </div>
                                </div>
                                <button type="submit" class="btn btn-primary" ng-click="btnGuardar()" >Guardar</button>
                        </div>
                    </div>
                </div>
                <!--DATOS-->

                <!--CONTRATOS-->
                <div class="tab-pane fade" id="Contratos" role="tabpanel">
                    <div class="card">
                        <div class="card-header">
                            <h5 class="card-title">Contratos del Cliente</h5>
