                <!--CONTRATOS-->
                <!--TELEFONOS-->
                <div class="tab-pane fade" id="Telefonos" role="tabpanel">
                    <div class="card">
                        <div class="card-header">
                            <h5 class="card-title">Telefonos</h5>
                            <button class="btn btn-pill btn-primary" ng-click="btnNuevoTelefonoo()">Nuevo</button>
                        </div>
                        <div class="card-body">
                            <div class="row">
                                <div class="col-xl-12">
                                    <table id="taTelefonos" class="table table-responsive table-sm table-hover" style="width:100%">
                                        <thead>
                                            <tr>
                                                <th>#</th>
                                                <th>Tipo</th>
