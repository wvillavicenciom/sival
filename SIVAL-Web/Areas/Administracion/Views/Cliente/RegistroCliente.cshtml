                                            <tr>
                                                <th>#</th>
                                                <th>Contrato</th>
                                                <th>Precio</th>
                                                <th>Inicial</th>
                                                <th>Financiado</th>
                                                <th>Plazo</th>
                                                <th>TEA</th>
                                                <th>Saldo</th>
                                                <th>-</th>
                                            </tr>
                                        </thead>
                                        <tfoot>
