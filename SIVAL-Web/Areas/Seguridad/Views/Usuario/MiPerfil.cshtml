
@{
    ViewData["Title"] = "MiPerfil";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@section Scripts {
    <script src="~/ClienteApp/Seguridad/Usuario/MiPerfil.js"></script>
}

<div class="container-fluid p-0" ng-controller="MiPerfil">

    <h1 class="h3 mb-3">Mi Perfíl</h1>

    <div class="row">

        <div class="col-md-3 col-xl-2">

            <div class="card">
                <div class="card-header">
                    <h5 class="card-title mb-0">Usuario</h5>
                </div>

                <div class="list-group list-group-flush" role="tablist">
                    <a class="list-group-item list-group-item-action active" data-bs-toggle="list" href="#DatosCliente" role="tab" aria-selected="true">
                        Datos
                    </a>
                    <a class="list-group-item list-group-item-action" data-bs-toggle="list" href="#Seguridad" role="tab" aria-selected="false" tabindex="-1">
                        Seguridad
                    </a>
                    <a class="list-group-item list-group-item-action" data-bs-toggle="list" href="#Desembolso" role="tab" aria-selected="false" tabindex="-1">
                        Alertas
                    </a>                    
                </div>
            </div>
        </div>

        <div class="col-md-9 col-xl-10">
            <div class="tab-content">
                <!--DATOS-->
                <div class="tab-pane fade active show" id="DatosCliente" role="tabpanel">
                    <div class="card">
                        <div class="card-header">
                            <h5 class="card-title mb-0">Datos Cliente</h5>
                        </div>
                        <div class="card-body">
                            <div class="row">
                                <div class="mb-3 col-md-6">
                                    <label for="inputFirstName" class="form-label">Tipo Documento</label>
                                    <select class="form-control" ng-model="ddlTipoDocumento" ng-options="item as item.nombre for item in oListaTipoDocumento" ng-disabled="ddlTipoDocumento_Disable"></select>
                                </div>
                                <div class="mb-3 col-md-6">
                                    <label for="txtDocumento" class="form-label">Documento</label>
                                    <input type="text" class="form-control" id="txtDocumento" ng-model="txtDocumento" placeholder="Documento" ng-disabled="txtDocumento_Disable">
                                </div>
                            </div>
                            <div class="row">
                                <div class="mb-3 col-md-6">
                                    <label for="txtApellidoPaterno" class="form-label">Apellido Paterno</label>
                                    <input type="text" class="form-control" id="txtApellidoPaterno" ng-model="txtApellidoPaterno" placeholder="Ingrese apellido paterno" ng-disabled="txtApellidoPaterno_Disable">
                                </div>
                                <div class="mb-3 col-md-6">
                                    <label for="txtApellidoMaterno" class="form-label">Apellido Materno</label>
                                    <input type="text" class="form-control" id="txtApellidoMaterno" ng-model="txtApellidoMaterno" placeholder="Ingrese apellido materno" ng-disabled="txtApellidoMaterno_Disable">
                                </div>
                            </div>
                            <div class="row">
                                <div class="mb-3 col-md-6">
                                    <label for="txtNombres" class="form-label">Nombres</label>
                                    <input type="text" class="form-control" id="txtNombres" ng-model="txtNombres" placeholder="Ingrese nombres" ng-disabled="txtNombres_Disable">
                                </div>
                                <div class="mb-3 col-md-6">
                                    <label for="inputFirstName" class="form-label">Tipo Usuario</label>
                                    <select class="form-control" ng-model="ddlTipoUsuario" ng-options="item as item.nombre for item in oListaTipoUsuario" ng-disabled="ddlTipoUsuario_Disable"></select>
                                </div>
                            </div>
                            <div class="row">
                                <div class="mb-3 col-md-6">
                                    <label class="form-check">
                                        <input type="checkbox" class="form-check-input" name="validation-checkbox-group-1" ng-model="cbkActivo" ng-disabled="cbkActivo_Disabled">
                                        <span class="form-check-label">Activo</span>
                                    </label>
                                </div>
                                <div class="mb-3 col-md-6">
                                    <label class="form-check">
                                        <input type="checkbox" class="form-check-input" name="validation-checkbox-group-2" ng-model="cbkAdministrador" ng-disabled="cbkAdministrador_Disabled">
                                        <span class="form-check-label">Administrador</span>
                                    </label>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
                <!--DATOS-->
                <!--Seguridad-->
                <div class="tab-pane fade" id="Seguridad" role="tabpanel">

                    <div class="card">
                        <div class="card-header">
                            <h5 class="card-title mb-0">Seguridad</h5>
                        </div>
                        <div class="card-body">
                            <div class="row">
                                <div class="mb-3 col-md-4">
                                    <label for="txtUsuario" class="form-label">Usuario</label>
                                    <input type="text" class="form-control" id="txtUsuario" ng-model="txtUsuario" placeholder="Ingrese Usuario" ng-disabled="txtUsuario_Disable">
                                </div>
                                <div class="mb-3 col-md-8">
                                </div>
                            </div>
                            <div class="row">
                                <div class="mb-3 col-md-4">
                                    <label for="txtClave" class="form-label">Clave</label>
                                    <input type="text" class="form-control" id="txtClave" ng-model="txtClave" placeholder="Ingrese Clave" ng-disabled="txtClaveDisable">
                                </div>
                                <div class="mb-3 col-md-4">
                                    <label for="txtClaveRepetir" class="form-label">Repetir Clave</label>
                                    <input type="text" class="form-control" id="txtClaveRepetir" ng-model="txtClaveRepetir" placeholder="Repita Clave" ng-disabled="txtClaveRepetir_Disable">
                                </div>
                                <div class="mb-3 col-md-4">
                                    <button type="submit" class="btn btn-success" ng-click="btnCambiarClave()" ng-disabled="btnCambiarClave_Disable">Cambiar Clave</button>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
                <!--Seguridad-->
                <!--Alertas-->
                <div class="tab-pane fade " id="Desembolso" role="tabpanel">
                    <div class="card">
                        <div class="card-header">
                            <h5 class="card-title mb-0">Alertas</h5>
                        </div>
                        <div class="card-body">

                        </div>
                    </div>
                </div>
                <!--Alertas-->


                <div class="card">
                    <div class="card-header">
                        <h5 class="card-title mb-0">Acciones</h5>
                    </div>
                    <div class="card-body">
                        <div class="row">
                            <div class="mb-3 col-md-3">
                            </div>
                            <div class="mb-3 col-md-6">
                                <button type="submit" class="btn btn-success" ng-click="btnGuardar()" ng-disabled="btnGuardar_Disable">Grabar</button>
                                @*<button type="submit" class="btn btn-danger" ng-click="btnAnular()" ng-disabled="btnAnular_Disable">Anular</button>*@
                            </div>
                            <div class="mb-3 col-md-3">
                            </div>
                        </div>
                    </div>
                </div>


            </div>
        </div>

    </div>

</div>


